{
  "mcpServers": {
    "angular-cli": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"],
      "env": {}
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ebmrpeiwypxtsoxguhjq&read_only=true&features=docs,database,development,debugging"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "daisyui": {
      "type": "http",
      "url": "https://gitmcp.io/saadeghi/daisyui"
    },
    "firebase": {
      "type": "stdio",
      "command": "firebase",
      "args": ["experimental:mcp"],
      "env": {}
    }
  }
}
